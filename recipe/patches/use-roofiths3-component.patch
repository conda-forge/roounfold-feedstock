From ef104c9b92bbaa32a85172a5300e158f104d7c68 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Use the RooFitHS3 ROOT component instead of
 RooFitJSONInterface

ROOT 6.40 removed the roofit/jsoninterface directory and folded
libRooFitJSONInterface into libRooFitHS3, so find_package(ROOT COMPONENTS ...
RooFitJSONInterface) fails with

  ROOT component RooFitJSONInterface not found

RooFitHS3 is a component in 6.36, 6.38 and 6.40 alike, and it is where the
JSONNode / JSONTree symbols used by src/RooFitUnfold.cxx now live: up to 6.38
libRooFitHS3 depends on libRooFitJSONInterface, and from 6.40 it installs
RooFit/Detail/JSONInterface.h itself.
---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a0d702c..521e20f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -17,7 +17,7 @@ mark_as_advanced(VERSION_MAJOR VERSION_MINOR)
 set(CMAKE_BUILD_TYPE Debug)
 # set(CMAKE_BUILD_TYPE Release)
 
-find_package( ROOT COMPONENTS Tree  Matrix Hist RIO MathCore Physics RooFitCore RooFit RooFitJSONInterface HistFactory Graf Postscript Gpad XMLParser)
+find_package( ROOT COMPONENTS Tree  Matrix Hist RIO MathCore Physics RooFitCore RooFit RooFitHS3 HistFactory Graf Postscript Gpad XMLParser)
 
 option (RooUnfoldGenerateCMakeConfig "generate a RooUnfoldConfig.cmake file for dependency tracking with other packages" OFF)
 # See https://cmake.org/cmake/help/latest/policy/CMP0077.html
